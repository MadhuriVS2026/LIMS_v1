APP_NAME=Anti Gravity LIMS
APP_VERSION=2.0.0
DEBUG=true

DATABASE_URL=sqlite+aiosqlite:///./lims.db

JWT_SECRET_KEY=change-me-in-production-use-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

LOG_LEVEL=INFO
LOG_FILE_PATH=logs/application.log

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8888"]

# SAP Integration Suite (CPI) only — see sap-integration/LIMS_QAS.postman_collection.json
# No other host is ever called by this client.
SAP_USE_LIVE_CLIENT=false
SAP_CPI_BASE_URL=https://your-tenant.it-cpi021-rt.cfapps.in30.hana.ondemand.com
SAP_CPI_USERNAME=
SAP_CPI_PASSWORD=
SAP_CPI_TIMEOUT_SECONDS=30

# Shared secret SAP CPI must send as x-api-key when pushing inspection lot
# data to POST /api/v1/sap/inbound/inspection-lot. Required outside local dev.
SAP_INBOUND_API_KEY=
