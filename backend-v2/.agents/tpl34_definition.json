{
  "resultRef": null,
  "context": [
    {
      "key": "product",
      "kind": "context",
      "type": "text",
      "label": "PRODUCT",
      "source": "product.name",
      "overridable": true
    },
    {
      "key": "batch_no",
      "kind": "context",
      "type": "text",
      "label": "Batch No.",
      "source": "trf.batch_number",
      "overridable": true
    },
    {
      "key": "label_claim_mgml",
      "kind": "context",
      "label": "LABEL CLAIM (mg/mL)",
      "source": "trf.label_claim_numeric",
      "overridable": true
    },
    {
      "key": "trf_no",
      "kind": "context",
      "type": "text",
      "label": "TRF No.",
      "source": "trf.trf_number",
      "overridable": true
    },
    {
      "key": "ar_no",
      "kind": "context",
