      "overridable": true
    },
    {
      "key": "avg_weight",
      "kind": "context",
      "label": "Average Weight / Vial",
      "default": 1,
      "overridable": true
    },
    {
      "key": "initial_volume",
      "kind": "context",
      "label": "Initial Media Volume",
      "unit": "mL",
      "default": 500,
      "overridable": true
    },
    {
      "key": "withdrawal_volume",
      "kind": "context",
      "label": "Withdrawal Volume",
