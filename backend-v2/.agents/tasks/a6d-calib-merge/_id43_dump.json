      "type": "text",
      "label": "A.R. No.",
      "default": "AD/048/26/0121",
      "overridable": true
    }
  ],
  "groups": [
    {
      "key": "calibration",
      "kind": "table",
      "label": "Calibration Standards",
      "rows": {
        "min": 2,
        "max": 10,
        "default": 6,
        "labelFrom": "level"
      },
      "fields": [
        {
          "key": "level",
          "kind": "input",
          "type": "text",
          "label": "Standard"
        },
        {
          "key": "nominal_pct",
          "kind": "input",
          "label": "Nominal",
          "unit": "%"
        },
        {
          "key": "weight_mg",
          "kind": "input",
          "label": "Std. Wt.",
          "unit": "mg",
          "required": true
        },
        {
          "key": "c_vol_1",
          "kind": "input",
          "label": "Vol 1",
          "unit": "mL",
          "required": true
        },
        {
          "key": "c_pip_1",
          "kind": "input",
          "label": "Pip 1",
          "unit": "mL",
          "default": 1
        },
        {
          "key": "c_vol_2",
          "kind": "input",
          "label": "Vol 2",
          "unit": "mL",
          "default": 1
        },
        {
          "key": "c_pip_2",
          "kind": "input",
          "label": "Pip 2",
          "unit": "mL",
          "default": 1
        },
        {
          "key": "c_vol_3",
          "kind": "input",
          "label": "Vol 3",
          "unit": "mL",
          "default": 1
        },
        {
          "key": "theoretical_ppm",
          "kind": "calculated",
          "label": "Theoretical Conc.",
          "unit": "ppm",
          "expression": "weight_mg / c_vol_1 * c_pip_1 / c_vol_2 * c_pip_2 / c_vol_3 * potency / 100 * 1000"
        },
        {
          "key": "area",
          "kind": "area",
          "label": "Area Response",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "observed_ppm",
          "kind": "calculated",
          "label": "Observed Conc.",
          "unit": "ppm",
          "expression": "(area - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "recovery_pct",
          "kind": "calculated",
          "label": "% Recovery",
          "unit": "%",
          "expression": "observed_ppm / theoretical_ppm * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        }
      ]
    },
    {
      "key": "curve",
      "kind": "singleton",
      "label": "Regression",
      "fields": [
        {
          "key": "curve_slope",
          "kind": "calculated",
          "label": "Slope",
          "unit": "area / ppm",
          "expression": "slope(calibration.area, calibration.theoretical_ppm)",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "curve_intercept",
          "kind": "calculated",
          "label": "Intercept",
          "expression": "intercept(calibration.area, calibration.theoretical_ppm)",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "correlation",
          "kind": "calculated",
          "label": "Correlation (r)",
          "expression": "correl(calibration.area, calibration.theoretical_ppm)",
          "rounding": {
            "mode": "round",
            "digits": 4
          }
        }
      ]
    },
    {
      "key": "qc",
      "kind": "table",
      "label": "Bracketing QC Standards",
      "rows": {
        "min": 0,
        "max": 24,
        "default": 6,
        "labelFrom": "level"
      },
      "fields": [
        {
          "key": "level",
          "kind": "input",
          "type": "text",
          "label": "QC"
        },
        {
          "key": "theoretical_ppm",
          "kind": "input",
          "label": "Theoretical Conc.",
          "unit": "ppm"
        },
        {
          "key": "area",
          "kind": "area",
          "label": "Area Response",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "observed_ppm",
          "kind": "calculated",
          "label": "Observed Conc.",
          "unit": "ppm",
          "expression": "(area - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "recovery_pct",
          "kind": "calculated",
          "label": "% Recovery",
          "unit": "%",
          "expression": "observed_ppm / theoretical_ppm * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        }
      ]
    },
    {
      "key": "linearity",
      "kind": "sequence",
      "label": "Standard Tapinarof for Linearity",
      "rows": {
        "min": 9,
        "max": 15,
        "default": 9,
        "labelFrom": "calibration_curve",
        "seed": [
          {
            "calibration_curve": "Calibration standard-1",
            "concentration_pct": 1
          },
          {
            "calibration_curve": "Calibration standard-2",
            "concentration_pct": 5
          },
          {
            "calibration_curve": "Calibration standard-3",
            "concentration_pct": 15
          },
          {
            "calibration_curve": "Calibration standard-4",
            "concentration_pct": 30
          },
          {
            "calibration_curve": "Calibration standard-5",
            "concentration_pct": 40
          },
          {
            "calibration_curve": "Calibration standard-6",
            "concentration_pct": 60
          },
          {
            "calibration_curve": "LQC",
            "concentration_pct": 1
          },
          {
            "calibration_curve": "MQC",
            "concentration_pct": 15
          },
          {
            "calibration_curve": "HQC",
            "concentration_pct": 30
          }
        ]
      },
      "fields": [
        {
          "key": "calibration_curve",
          "kind": "input",
          "type": "text",
          "label": "Calibration curve"
        },
        {
          "key": "concentration_pct",
          "kind": "input",
          "type": "number",
          "label": "Concentration",
          "unit": "%"
        },
        {
          "key": "std_weight_mg",
          "kind": "input",
          "type": "number",
          "label": "Standard Weight",
          "unit": "mg"
        },
        {
          "key": "diluted_to_ml_1",
          "kind": "input",
          "type": "number",
          "label": "Diluted to",
          "unit": "mL"
        },
        {
          "key": "ml_a",
          "kind": "input",
          "type": "number",
          "label": "mL",
          "unit": "mL"
        },
        {
          "key": "ml_b",
          "kind": "input",
          "type": "number",
          "label": "mL",
          "unit": "mL"
        },
        {
          "key": "ml_taken",
          "kind": "input",
          "type": "number",
          "label": "mL taken",
          "unit": "mL"
        },
        {
          "key": "diluted_to_ml_2",
          "kind": "input",
          "type": "number",
          "label": "Diluted to",
          "unit": "mL"
        }
      ]
    },
    {
      "key": "cells",
      "kind": "singleton",
      "label": "Cell Loading",
      "fields": [
        {
          "key": "applied_mg_1",
          "kind": "input",
          "label": "Cell 1 Applied Dose",
          "unit": "mg"
        },
        {
          "key": "applied_mg_2",
          "kind": "input",
          "label": "Cell 2 Applied Dose",
          "unit": "mg"
        },
        {
          "key": "applied_mg_3",
          "kind": "input",
          "label": "Cell 3 Applied Dose",
          "unit": "mg"
        },
        {
          "key": "applied_mg_4",
          "kind": "input",
          "label": "Cell 4 Applied Dose",
          "unit": "mg"
        },
        {
          "key": "applied_mg_5",
          "kind": "input",
          "label": "Cell 5 Applied Dose",
          "unit": "mg"
        },
        {
          "key": "applied_mg_6",
          "kind": "input",
          "label": "Cell 6 Applied Dose",
          "unit": "mg"
        }
      ]
    },
    {
      "key": "sampling_details",
      "kind": "singleton",
      "label": "Sampling details",
      "fields": [
        {
          "key": "sample_weight_mg_1",
          "kind": "input",
          "type": "number",
          "label": "Cell 1 Sample Weight",
          "unit": "mg"
        },
        {
          "key": "sample_weight_mg_2",
          "kind": "input",
          "type": "number",
          "label": "Cell 2 Sample Weight",
          "unit": "mg"
        },
        {
          "key": "sample_weight_mg_3",
          "kind": "input",
          "type": "number",
          "label": "Cell 3 Sample Weight",
          "unit": "mg"
        },
        {
          "key": "sample_weight_mg_4",
          "kind": "input",
          "type": "number",
          "label": "Cell 4 Sample Weight",
          "unit": "mg"
        },
        {
          "key": "sample_weight_mg_5",
          "kind": "input",
          "type": "number",
          "label": "Cell 5 Sample Weight",
          "unit": "mg"
        },
        {
          "key": "sample_weight_mg_6",
          "kind": "input",
          "type": "number",
          "label": "Cell 6 Sample Weight",
          "unit": "mg"
        }
      ]
    },
    {
      "key": "timepoints",
      "kind": "sequence",
      "label": "Sampling Timepoints",
      "rows": {
        "min": 2,
        "max": 12,
        "default": 6,
        "labelFrom": "time_min"
      },
      "fields": [
        {
          "key": "time_min",
          "kind": "input",
          "label": "Time",
          "unit": "min",
          "required": true
        },
        {
          "key": "area_1",
          "kind": "area",
          "label": "Cell 1 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "area_2",
          "kind": "area",
          "label": "Cell 2 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "area_3",
          "kind": "area",
          "label": "Cell 3 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "area_4",
          "kind": "area",
          "label": "Cell 4 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "area_5",
          "kind": "area",
          "label": "Cell 5 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "area_6",
          "kind": "area",
          "label": "Cell 6 Area",
          "unit": "\u00b5V\u00b7s"
        },
        {
          "key": "sqrt_hours",
          "kind": "calculated",
          "label": "\u221aTime",
          "unit": "\u221ah",
          "expression": "sqrt(time_min / 60)"
        },
        {
          "key": "conc_1",
          "kind": "calculated",
          "label": "Cell 1 Conc.",
          "unit": "ppm",
          "expression": "(area_1 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "conc_2",
          "kind": "calculated",
          "label": "Cell 2 Conc.",
          "unit": "ppm",
          "expression": "(area_2 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "conc_3",
          "kind": "calculated",
          "label": "Cell 3 Conc.",
          "unit": "ppm",
          "expression": "(area_3 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "conc_4",
          "kind": "calculated",
          "label": "Cell 4 Conc.",
          "unit": "ppm",
          "expression": "(area_4 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "conc_5",
          "kind": "calculated",
          "label": "Cell 5 Conc.",
          "unit": "ppm",
          "expression": "(area_5 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "conc_6",
          "kind": "calculated",
          "label": "Cell 6 Conc.",
          "unit": "ppm",
          "expression": "(area_6 - curve.curve_intercept) / curve.curve_slope"
        },
        {
          "key": "amount_1",
          "kind": "calculated",
          "label": "Cell 1 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_1 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "amount_2",
          "kind": "calculated",
          "label": "Cell 2 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_2 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "amount_3",
          "kind": "calculated",
          "label": "Cell 3 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_3 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "amount_4",
          "kind": "calculated",
          "label": "Cell 4 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_4 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "amount_5",
          "kind": "calculated",
          "label": "Cell 5 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_5 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "amount_6",
          "kind": "calculated",
          "label": "Cell 6 Amount (uncorrected)",
          "unit": "\u00b5g",
          "expression": "conc_6 * sample_vol / sample_pip * receptor_volume"
        },
        {
          "key": "carry_1",
          "kind": "calculated",
          "label": "Cell 1 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_1) * replacement_volume / receptor_volume"
        },
        {
          "key": "carry_2",
          "kind": "calculated",
          "label": "Cell 2 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_2) * replacement_volume / receptor_volume"
        },
        {
          "key": "carry_3",
          "kind": "calculated",
          "label": "Cell 3 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_3) * replacement_volume / receptor_volume"
        },
        {
          "key": "carry_4",
          "kind": "calculated",
          "label": "Cell 4 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_4) * replacement_volume / receptor_volume"
        },
        {
          "key": "carry_5",
          "kind": "calculated",
          "label": "Cell 5 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_5) * replacement_volume / receptor_volume"
        },
        {
          "key": "carry_6",
          "kind": "calculated",
          "label": "Cell 6 carry-over",
          "unit": "\u00b5g",
          "expression": "sum(prior.amount_6) * replacement_volume / receptor_volume"
        },
        {
          "key": "cumulative_1",
          "kind": "calculated",
          "label": "Cell 1 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_1 + carry_1"
        },
        {
          "key": "cumulative_2",
          "kind": "calculated",
          "label": "Cell 2 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_2 + carry_2"
        },
        {
          "key": "cumulative_3",
          "kind": "calculated",
          "label": "Cell 3 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_3 + carry_3"
        },
        {
          "key": "cumulative_4",
          "kind": "calculated",
          "label": "Cell 4 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_4 + carry_4"
        },
        {
          "key": "cumulative_5",
          "kind": "calculated",
          "label": "Cell 5 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_5 + carry_5"
        },
        {
          "key": "cumulative_6",
          "kind": "calculated",
          "label": "Cell 6 Cumulative",
          "unit": "\u00b5g",
          "expression": "amount_6 + carry_6"
        },
        {
          "key": "per_area_1",
          "kind": "calculated",
          "label": "Cell 1 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_1 / donor_area"
        },
        {
          "key": "per_area_2",
          "kind": "calculated",
          "label": "Cell 2 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_2 / donor_area"
        },
        {
          "key": "per_area_3",
          "kind": "calculated",
          "label": "Cell 3 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_3 / donor_area"
        },
        {
          "key": "per_area_4",
          "kind": "calculated",
          "label": "Cell 4 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_4 / donor_area"
        },
        {
          "key": "per_area_5",
          "kind": "calculated",
          "label": "Cell 5 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_5 / donor_area"
        },
        {
          "key": "per_area_6",
          "kind": "calculated",
          "label": "Cell 6 Cumulative / Area",
          "unit": "\u00b5g/cm\u00b2",
          "expression": "cumulative_6 / donor_area"
        },
        {
          "key": "released_pct_1",
          "kind": "calculated",
          "label": "Cell 1 Released",
          "unit": "%",
          "expression": "cumulative_1 / (cells.applied_mg_1 * label_claim / 100 * 1000) * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "released_pct_2",
          "kind": "calculated",
          "label": "Cell 2 Released",
          "unit": "%",
          "expression": "cumulative_2 / (cells.applied_mg_2 * label_claim / 100 * 1000) * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "released_pct_3",
          "kind": "calculated",
          "label": "Cell 3 Released",
          "unit": "%",
          "expression": "cumulative_3 / (cells.applied_mg_3 * label_claim / 100 * 1000) * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "released_pct_4",
          "kind": "calculated",
          "label": "Cell 4 Released",
          "unit": "%",
          "expression": "cumulative_4 / (cells.applied_mg_4 * label_claim / 100 * 1000) * 100",
          "rounding": {
            "mode": "round",
            "digits": 2
          }
        },
        {
          "key": "released_pct_5",
          "kind": "calculated",
